# Required authentication
# Copy this file to .env and paste only your own authenticated Suno cookie.
# Never commit .env. If a cookie contains '$', Docker Compose may require '$$'.
SUNO_COOKIE=

# Optional captcha automation for create/cover/extend/mashup
TWOCAPTCHA_API_KEY=
SUNO_CREATE_CAPTCHA_METHOD=auto
SUNO_CREATE_CAPTCHA_SHARED_PROXY_URL=
SUNO_CREATE_HCAPTCHA_TOKEN_MODE=browser
SUNO_CREATE_TURNSTILE_SITEKEY=
SUNO_CREATE_HCAPTCHA_SITEKEY=
SUNO_CREATE_HCAPTCHA_RQDATA=
SUNO_CREATE_HCAPTCHA_API_DOMAIN=
SUNO_CREATE_CAPTCHA_PAGEURL=
SUNO_CREATE_CAPTCHA_ACTION=
SUNO_CREATE_CAPTCHA_CDATA=
SUNO_CREATE_CAPTCHA_PAGEDATA=
SUNO_CREATE_USER_TIER=

# Generic workspace and output defaults
SUNO_DEFAULT_WORKSPACE=SunoApi
SUNO_OUTPUT_DIR=/app/output
SUNO_ACCOUNT_ARCHIVE_DIR=/app/output/suno-account-archive
SUNO_OUTPUT_TIMEZONE=UTC

# Local API and CLI
SUNO_API_BIND=127.0.0.1
SUNO_API_PORT=3000
SUNO_API_BASE_URL=http://127.0.0.1:3000
SUNO_OPENCLI_BASE_URL=http://127.0.0.1:3000
SUNO_ARCHIVE_API_BASE=http://127.0.0.1:3000

# Optional outbound proxy. Leave empty when direct Internet access works.
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=127.0.0.1,localhost,host.docker.internal
DOCKER_HTTP_PROXY=
DOCKER_HTTPS_PROXY=
DOCKER_ALL_PROXY=
DOCKER_NO_PROXY=127.0.0.1,localhost,host.docker.internal

# Optional client identity overrides for upstream compatibility
SUNO_CLIENT_USER_AGENT=
SUNO_CLIENT_ACCEPT_LANGUAGE=
SUNO_CLIENT_SEC_CH_UA=

# Song Auto Split and Studio Multitrack output
SUNO_STEMS_DOWNLOAD_DIR=/app/output/suno-stems-downloads
SUNO_STUDIO_MULTITRACK_DOWNLOAD_DIR=/app/output/suno-studio-multitrack-downloads
SUNO_STEMS_QUEUE_TIMEOUT_MS=1800000
SUNO_STEMS_BROWSER_FALLBACK=false
SUNO_BROWSER_CDP=http://host.docker.internal:18800

# Suno Studio direct-HTTP integration
SUNO_STUDIO_DIRECT_BASE_URL=https://studio-api.prod.suno.com
SUNO_STUDIO_STATE_DIR=/app/.suno-studio-state
SUNO_STUDIO_OUTPUT_DIR=/app/output/studio-exports

# Paid and unverified Studio writes are intentionally disabled by default.
SUNO_STUDIO_ENABLE_PAID_GENERATION=0
SUNO_STUDIO_ENABLE_UNVERIFIED_WRITES=0
SUNO_STUDIO_PAID_API_TOKEN=
